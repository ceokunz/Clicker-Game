<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Clicker"
        mc:Ignorable="d"
        Title="POPAKAKA" Height="423" Width="825"
        >

    <Window.Resources>
        <local:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter"/>
    </Window.Resources>
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!--///-->

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="List of enemies:" Height="30"></TextBlock>
            <ListBox Name="EnemyListBox" Grid.Row="1" Margin="5" ItemsSource="{Binding EnemyList.enemies}" SelectionChanged="EnemyListBox_SelectionChanged" DisplayMemberPath="Name"/>
            <UniformGrid Grid.Row="2" Columns="2" Height="40">
                <Button Click="Button_SaveToJson" Content="SAVE" Margin="5,5,4,5"/>
                <Button Click="Button_LoadFromJson" Content="LOAD" Margin="5"/>
            </UniformGrid>

        </Grid>

        <Grid Grid.Column="1">
            <!--///-->

            <Grid.RowDefinitions>
                <!--добавляю три ряда-->
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!--в 1 ряд добавляю 2 колонны-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Enemy icon:" Width="200" Height="50" Background="White"></TextBlock>
                    <Image Name="scene" Grid.Row="1" Width="100" Height="100"  HorizontalAlignment="Left" Source="{Binding ElementName=EnemyListBox, Path=SelectedItem.IconName, Mode=TwoWay}"/>
<!--Source="{Binding ElementName=EnemyListBox, Path=SelectedItem.IconName Converter={StaticResource ImagePathToImageSourceConverter}}-->
                </Grid>

                <Grid Grid.Column="1">
                    <UniformGrid Columns="1">
                        <TextBlock Text="Icon name:"></TextBlock>
                        <TextBox Name="IconNameBox" Margin="10" Background="#FFEDEDED" IsReadOnly="True" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.IconName, Mode=TwoWay}"></TextBox>
                        <TextBlock Text="Enemy name:"></TextBlock>
                        <TextBox Name="EnemyNameBox" Margin="10" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.Name, Mode=TwoWay}"></TextBox>
                    </UniformGrid>
                </Grid>

            </Grid>

            <Grid Grid.Row="1">
                <!--Фигачу второй ряд-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="0" Columns="1">
                    <TextBlock Text="Base life:"></TextBlock>
                    <TextBox Name="BaseLifeBox" Margin="5" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.BaseLife, Mode=TwoWay}"></TextBox>
                    <TextBlock Text="Life modifier:"></TextBlock>
                    <TextBox Name="LifeModBox" Margin="5" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.LifeModifier, Mode=TwoWay}"></TextBox>
                    <TextBlock Text="Spawn chance (1-100):"></TextBlock>
                </UniformGrid>

                <UniformGrid Grid.Column="1" Columns="1">
                    <TextBlock Text="Base gold:"></TextBlock>
                    <TextBox Name="BaseGoldBox" Margin="5" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.BaseGold, Mode=TwoWay}"></TextBox>
                    <TextBlock Text="Gold modifier:"></TextBlock>
                    <TextBox Name="GoldModBox" Margin="5" Text="{Binding ElementName=EnemyListBox, Path=SelectedItem.GoldModifier, Mode=TwoWay}"></TextBox>
                    <TextBlock></TextBlock>
                    <!--Загадочные обстоятельства-->
                </UniformGrid>

            </Grid>

            <Grid Grid.Row="2">
                <!--Третий ряд для моих похорон я уже хочу умереть пожалуйста-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBox Name="SpawnChanceBox" Width="200" Height="50" Margin="5"></TextBox>

                <UniformGrid Grid.Column="1" Rows="1">
                    <Button Click="Button_AddEnemy" Content="ADD" Margin="5"></Button>
                    <Button Click="Button_RemoveEnemy" Content="REMOVE" Margin="5"></Button>
                </UniformGrid>
            </Grid>

        </Grid>

        <Grid Grid.Column="2">
            <!--///-->
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" Name="IconListBox" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="IconListBox_OnSelectionChanged">
                <ListBox.ItemsPanel>
                    <!-- WrapPanel, чтобы иконки располагались в несколько рядов -->
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <!-- Шаблон элемента, который отображает иконку -->
                    <DataTemplate>
                        <StackPanel>
                            <Image Source="{Binding IconPath}" Width="50" Height="50"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="1" Margin="10" Content="ДЕПНУТЬ ЗЛАТУ И ВАЛЕРУ В КАЗИК" Click="Dodep"/>
        </Grid>

    </Grid>
</Window>
